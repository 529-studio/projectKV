# Vision / Traffic Analyzer: "none" | "mock" | "vlm" (default: "none")
ANALYZER=vlm

# Google Gemini API Key for VLM Vision features (Gemini 2.0 Flash)
# Get free API key at: https://aistudio.google.com/app/apikey
CLOUD_VISION_API_KEY=
# Fallback alias:
# GEMINI_API_KEY=

# Upstream DOT snapshot portal URL
SNAPSHOT_UPSTREAM_BASE_URL=https://giaothong.hochiminhcity.gov.vn/render/ImageHandler.ashx

# Map basemap (Issue #443 / S14-T3)
# The backend tile proxy caches raster tiles and re-renders them as high-contrast
# dark cartography, so the commuter map stays readable in direct sunlight with no
# third-party key. Override the provider with a base URL (no trailing slash);
# {s} and {r} placeholders are expanded server-side.
MAP_TILE_UPSTREAM_URL=https://tile.openstreetmap.org
# Optional provider key, appended as ?api_key=. Never commit a real value.
MAP_TILE_API_KEY=
# 0 disables the dark render (only useful for debugging or a native dark provider).
MAP_TILE_DARKEN=1
# Frontend override: point the browser straight at a licensed native dark provider
# (e.g. https://{s}.basemaps.cartocdn.com/dark_all/{z}/{x}/{y}{r}.png) and set the
# matching attribution. Leave empty to use the proxy.
# NEXT_PUBLIC_MAP_TILE_URL=
# NEXT_PUBLIC_MAP_TILE_ATTRIBUTION=

# Local server port
PORT=3000

# Developer Security & Gatekeeper (Issue #214 / Lesson 28)
DEV_ACCESS_TOKEN=

# Cloudflare Zero Trust Access & Cryptographic JWT Verification (Issue #421)
CF_ACCESS_AUDIENCE=<your-cf-access-audience>
CF_ACCESS_CERTS_URL=https://<your-team-name>.cloudflareaccess.com/cdn-cgi/access/certs
CF_ACCESS_TEAM_NAME=<your-team-name>
CF_ACCESS_CLIENT_ID=<your-cf-access-client-id>
CF_ACCESS_CLIENT_SECRET=<your-cf-access-client-secret>

# CORS Whitelist (Issue #421)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,https://warded.529studio.site,https://warded-stg.529studio.site

# Object Storage Driver: "local" | "r2" (default: "local")
STORAGE_DRIVER=local
STORAGE_LOCAL_ROOT=./data/proofs

# Cloudflare R2 Object Storage (Bucket: warded-proofs)
R2_ACCOUNT_ID=<your-r2-account-id>
R2_ENDPOINT=https://<your-r2-account-id>.r2.cloudflarestorage.com
R2_BUCKET_NAME=warded-proofs
R2_REGION=auto
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_URL=https://file.529studio.site

# SQLite Continuous Replication & Disaster Recovery (Issue #442 / S14-T2)
# The staging Litestream sidecar streams the SQLite WAL every 1s to
# s3://${R2_BUCKET_NAME}/db-replicas/camera-view.db. These are dedicated
# credentials for replication; leave them empty to reuse R2_ACCESS_KEY_ID and
# R2_SECRET_ACCESS_KEY through the compose fallback. Verify recoverability with
# `make restore-drill` (see docs/runbooks/sqlite_litestream_disaster_recovery.md).
LITESTREAM_ACCESS_KEY_ID=<your-litestream-r2-access-key-id>
LITESTREAM_SECRET_ACCESS_KEY=<your-litestream-r2-secret-access-key>
LITESTREAM_CONTAINER_NAME=warded-litestream
LITESTREAM_CPU_LIMIT=0.20
LITESTREAM_MEMORY_LIMIT=64M
# One-shot volume ownership repair before the backend/forecast/Litestream start.
INIT_VOL_CONTAINER_NAME=warded-init-vol

# Telegram Flood Alert Dispatcher (Issue #225 / Sprint 6 S6-T5; staging verification Issue #246 / S8-T9)
TELEGRAM_BOT_TOKEN=<your-telegram-bot-token>
# Public handle only (not a credential), 4-31 chars, no leading "@".
# Empty disables the inbound webhook; the web UI then hides the deep-link CTA.
TELEGRAM_BOT_USERNAME=<your-telegram-bot-username>
# Inbound webhook secret, 32-256 chars from [A-Za-z0-9_-]. Generate with:
#   openssl rand -hex 32
# Never commit a real value; empty disables the webhook (fail-closed 404).
TELEGRAM_WEBHOOK_SECRET=<your-telegram-webhook-secret>
TELEGRAM_DEBOUNCE_MINUTES=30
# Ops pre-flight only (scripts/verify_staging_telegram.sh); the go-server resolves recipients from subscriptions
TELEGRAM_CHAT_ID=<your-telegram-chat-id>
# Autonomous Data Flywheel Harvester (Issue #299 / S9-T3)
HARVESTER_ENABLED=false
HARVESTER_SCHEDULE_HOURS=07:30,12:00,17:30
HARVESTER_CONCURRENCY=15
HARVESTER_RAIN_COOLDOWN_MINUTES=60
HARVESTER_CATCHUP_MINUTES=120

# Operational alerting (Issue #441 / S14-T1 scope 4)
# A Hot Set camera with no successful observation for this long logs [OPS_ALERT].
OPS_ALERT_FEED_DROPOUT_THRESHOLD=5m
# A continuously unhealthy cv-engine for this long logs [OPS_ALERT]. A standby
# engine (model_loaded=false) counts as unhealthy for alerting.
OPS_ALERT_CV_ENGINE_FAILURE_THRESHOLD=5m
# How often the watchdog probes the engine and re-evaluates liveness.
OPS_ALERT_EVALUATE_INTERVAL=30s
# Hot Set history provenance (Issue #441)
VERDICT_STALE_TTL_SECONDS=180
FROZEN_FRAME_THRESHOLD=10

# Forecast Automated Refit Daemon & Sidecar (Issue #413 / S12-T1)
COMPOSE_PROFILES=forecast-refit
FORECAST_REFIT_INTERVAL=21600
FORECAST_MIN_NEW_ROWS=50
FORECAST_CRON_CONTAINER_NAME=warded-forecast-cron
FORECAST_MODEL_PATH=/app/data/forecast/prototype_v1.json
FORECAST_MODEL_RELOAD_INTERVAL_SEC=60

# cv-engine Load-Shedding (Issue #379 / S10-T8 / ADR-012 §1.2 F5)
# Optional cv-engine input resolution override: 320, 416 (default), or 640 (ADR-012 §1.2 F5)
CV_INPUT_RESOLUTION=

# SAM Pre-Labeling Toolchain Weights (Issue #298 / S9-T2 / ADR-011 D3)
SAM_PRELABEL_ENCODER_ONNX=<path-to-mobile_sam_image_encoder.onnx>
SAM_PRELABEL_DECODER_ONNX=<path-to-sam_mask_decoder_multi.onnx>
SAM_PRELABEL_DETECTOR_ONNX=<path-to-yolov8n_640.onnx>

