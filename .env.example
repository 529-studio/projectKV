# Vision / Traffic Analyzer: "none" | "mock" | "vlm" (default: "none")
ANALYZER=vlm

# Google Gemini API Key for VLM Vision features (Gemini 2.0 Flash)
# Get free API key at: https://aistudio.google.com/app/apikey
CLOUD_VISION_API_KEY=
# Fallback alias:
# GEMINI_API_KEY=

# Upstream DOT snapshot portal URL
SNAPSHOT_UPSTREAM_BASE_URL=https://giaothong.hochiminhcity.gov.vn/render/ImageHandler.ashx

# Local server port
PORT=3000

# Developer Security & Gatekeeper (Issue #214 / Lesson 28)
DEV_ACCESS_TOKEN=

# Object Storage Driver: "local" | "r2" (default: "local")
STORAGE_DRIVER=local
STORAGE_LOCAL_ROOT=./data/proofs

# Cloudflare R2 Object Storage (Bucket: warded-proofs)
R2_ACCOUNT_ID=bb67574163a065e4aad475fb3aa6bb92
R2_ENDPOINT=https://bb67574163a065e4aad475fb3aa6bb92.r2.cloudflarestorage.com
R2_BUCKET_NAME=warded-proofs
R2_REGION=auto
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_URL=https://file.529studio.site

# Telegram Flood Alert Dispatcher (Issue #225 / Sprint 6 S6-T5)
TELEGRAM_BOT_TOKEN=<your-telegram-bot-token>
TELEGRAM_DEBOUNCE_MINUTES=30
