# Vision / Traffic Analyzer: "none" | "mock" | "vlm" (default: "none")
ANALYZER=vlm

# Google Gemini API Key for VLM Vision features (Gemini 2.0 Flash)
# Get free API key at: https://aistudio.google.com/app/apikey
CLOUD_VISION_API_KEY=
# Fallback alias:
# GEMINI_API_KEY=

# Upstream DOT snapshot portal URL
SNAPSHOT_UPSTREAM_BASE_URL=https://giaothong.hochiminhcity.gov.vn/render/ImageHandler.ashx

# Local server port
PORT=3000

# Developer Security & Gatekeeper (Issue #214 / Lesson 28)
DEV_ACCESS_TOKEN=

# Object Storage Driver: "local" | "r2" (default: "local")
STORAGE_DRIVER=local
STORAGE_LOCAL_ROOT=./data/proofs

# Cloudflare R2 Object Storage (Bucket: warded-proofs)
R2_ACCOUNT_ID=<your-r2-account-id>
R2_ENDPOINT=https://<your-r2-account-id>.r2.cloudflarestorage.com
R2_BUCKET_NAME=warded-proofs
R2_REGION=auto
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_URL=https://file.529studio.site

# Telegram Flood Alert Dispatcher (Issue #225 / Sprint 6 S6-T5; staging verification Issue #246 / S8-T9)
TELEGRAM_BOT_TOKEN=<your-telegram-bot-token>
TELEGRAM_DEBOUNCE_MINUTES=30
# Ops pre-flight only (scripts/verify_staging_telegram.sh); the go-server resolves recipients from subscriptions
TELEGRAM_CHAT_ID=<your-telegram-chat-id>
# Autonomous Data Flywheel Harvester (Issue #299 / S9-T3)
HARVESTER_ENABLED=false
HARVESTER_SCHEDULE_HOURS=07:30,12:00,17:30
HARVESTER_CONCURRENCY=15
HARVESTER_RAIN_COOLDOWN_MINUTES=60
HARVESTER_CATCHUP_MINUTES=120

# Forecast Automated Refit Daemon & Sidecar (Issue #413 / S12-T1)
COMPOSE_PROFILES=forecast-refit
FORECAST_REFIT_INTERVAL=21600
FORECAST_MIN_NEW_ROWS=50
FORECAST_CRON_CONTAINER_NAME=warded-forecast-cron
FORECAST_MODEL_PATH=/app/data/forecast/prototype_v1.json
FORECAST_MODEL_RELOAD_INTERVAL_SEC=60

# cv-engine Load-Shedding (Issue #379 / S10-T8 / ADR-012 §1.2 F5)
# Optional cv-engine input resolution override: 320, 416 (default), or 640 (ADR-012 §1.2 F5)
CV_INPUT_RESOLUTION=

# SAM Pre-Labeling Toolchain Weights (Issue #298 / S9-T2 / ADR-011 D3)
SAM_PRELABEL_ENCODER_ONNX=<path-to-mobile_sam_image_encoder.onnx>
SAM_PRELABEL_DECODER_ONNX=<path-to-sam_mask_decoder_multi.onnx>
SAM_PRELABEL_DETECTOR_ONNX=<path-to-yolov8n_640.onnx>

