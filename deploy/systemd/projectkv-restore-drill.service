[Unit]
Description=ProjectKV SQLite Disaster Recovery Restore Drill
Documentation=file:///opt/projectkv/docs/runbooks/sqlite_litestream_disaster_recovery.md
After=network.target

[Service]
Type=oneshot
User=projectkv
Group=projectkv
WorkingDirectory=/opt/projectkv
RuntimeDirectory=projectkv
StateDirectory=projectkv
EnvironmentFile=-/etc/default/projectkv-restore-drill
EnvironmentFile=-/opt/projectkv/.env
Nice=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/projectkv/data /run/projectkv /tmp
ExecStart=/usr/bin/python3 tools/deploy/restore_drill.py --mode auto --out /opt/projectkv/data/reports/weekly_restore_drill_summary.json
StandardOutput=journal
StandardError=journal
TimeoutStartSec=600

[Install]
WantedBy=multi-user.target
