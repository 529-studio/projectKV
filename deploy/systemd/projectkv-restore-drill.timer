[Unit]
Description=ProjectKV Weekly SQLite Disaster Recovery Restore Drill Timer
Documentation=file:///opt/projectkv/docs/runbooks/sqlite_litestream_disaster_recovery.md
Wants=projectkv-restore-drill.service

[Timer]
OnCalendar=Sun *-*-* 03:00:00 UTC
Persistent=true
AccuracySec=1min
RandomizedDelaySec=300

[Install]
WantedBy=timers.target
