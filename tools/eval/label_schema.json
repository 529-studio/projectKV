{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://projectkv.529studio.site/schemas/label.schema.json",
  "title": "ProjectKV Ground Truth Label Schema",
  "description": "JSON Schema Draft-07 compliant definition for dual-carriageway traffic density, red-light queue tracking, physical flood waterline depth, and environmental metadata.",
  "type": "object",
  "required": [
    "frame_id",
    "image_path",
    "labels",
    "annotator",
    "annotated_at"
  ],
  "properties": {
    "frame_id": {
      "type": "string",
      "description": "Unique identifier of the frame or camera snapshot."
    },
    "camera_id": {
      "type": "string",
      "description": "Optional camera hex ID."
    },
    "camera_name": {
      "type": "string",
      "description": "Human-readable camera location name."
    },
    "image_path": {
      "type": "string",
      "description": "Path to local or R2 image asset."
    },
    "annotator": {
      "type": "string",
      "description": "Identifier of the annotator or model tool."
    },
    "annotated_at": {
      "type": "string",
      "description": "ISO-8601 timestamp of annotation."
    },
    "notes": {
      "type": "string",
      "description": "Annotator observations, occlusion notes, or capacity baselines."
    },
    "labels": {
      "type": "object",
      "required": [
        "traffic",
        "flood"
      ],
      "properties": {
        "traffic": {
          "type": "string",
          "enum": ["CLEAR", "MODERATE", "HEAVY", "CONGESTED"],
          "description": "Global scene-level maximum traffic congestion."
        },
        "carriageway_direction": {
          "type": "string",
          "enum": ["inbound", "outbound", "bidirectional"],
          "description": "Carriageway flow orientation relative to camera perspective."
        },
        "traffic_dir_a": {
          "type": "string",
          "enum": ["CLEAR", "MODERATE", "HEAVY", "CONGESTED"],
          "description": "Traffic density in Direction A (approaching / near carriageway)."
        },
        "traffic_dir_b": {
          "type": "string",
          "enum": ["CLEAR", "MODERATE", "HEAVY", "CONGESTED", "NOT_APPLICABLE"],
          "description": "Traffic density in Direction B (receding / far carriageway)."
        },
        "is_waiting_red_light": {
          "type": "boolean",
          "description": "True if queue is transiently caused by traffic light cycle rather than true gridlock."
        },
        "queue_reason": {
          "type": "string",
          "enum": ["free_flow", "traffic_light", "bottleneck", "flood_barrier", "accident"],
          "description": "Primary root cause of vehicle queue."
        },
        "flood": {
          "type": "string",
          "enum": ["NONE", "SHALLOW", "DEEP"],
          "description": "Standard 3-tier severity classification for UI markers."
        },
        "waterline_depth": {
          "type": "string",
          "enum": [
            "DRY",
            "WET_SURFACE",
            "TIRE_QUARTER_SUBMERGED",
            "TIRE_HALF_SUBMERGED",
            "IMPASSABLE"
          ],
          "description": "Physical motorcycle wheel submersion depth anchor."
        },
        "flood_submersion_anchor": {
          "type": "string",
          "enum": [
            "dry",
            "wet_asphalt_no_standing",
            "tire_base_under_10cm",
            "exhaust_hub_over_15cm"
          ],
          "description": "Granular anchor mapped to physical motorcycle wheel landmarks."
        },
        "time_of_day": {
          "type": "string",
          "enum": ["day", "night", "dawn_dusk"],
          "description": "Lighting condition at time of capture."
        },
        "weather": {
          "type": "string",
          "enum": ["dry", "rain", "heavy_rain"],
          "description": "Precipitation level observed on camera."
        },
        "quality_tags": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "rain_on_lens",
              "night_glare",
              "occluded",
              "signal_noise"
            ]
          },
          "description": "Optical distortion and quality flags."
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
