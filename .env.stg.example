# ==============================================================================
# Environment Configuration Template for Staging Deployment
# ==============================================================================
#
# This file is reference documentation, not an input to any deploy. Since
# 2026-11-15 every value below is a default baked into docker-compose.stg.yml
# (`${VAR:-default}`), so the repository owns the configuration. The Portainer
# stack environment holds credentials and the CI-written image tags only; a
# non-secret value left there would override the compose default and silently
# win, which is the drift this split exists to prevent.

# --- Infrastructure & Network ---
PULL_POLICY=missing
DOCKER_NETWORK=core-network
DATA_VOLUME_NAME=warded-stg_warded-stg-data
ROUTER_NAME=warded
DOMAIN_NAME=warded.529studio.site
TRAEFIK_ENTRYPOINT=web

# --- Backend Service (warded-backend) ---
BE_IMAGE_NAME=ghcr.io/529-studio/projectkv-backend
BE_IMAGE_TAG=stg-latest
BE_CONTAINER_NAME=warded-backend
BE_PORT=3000
BE_CPU_LIMIT=0.50
BE_MEMORY_LIMIT=256M
GIN_MODE=release
APP_ENV=staging
TZ=Asia/Ho_Chi_Minh
CAMERAS_FILE_PATH=/app/cameras_enriched.json
HEX_POLYGON_FILE_PATH=/app/h3_hex_polygons.json
SQLITE_PATH=/app/data/camera-view.db

# --- Frontend Service (warded-frontend) ---
FE_IMAGE_NAME=ghcr.io/529-studio/projectkv-frontend
FE_IMAGE_TAG=stg-latest
FE_CONTAINER_NAME=warded-frontend
FE_CPU_LIMIT=0.25
FE_MEMORY_LIMIT=64M

# --- Model Service (warded-model) ---
MODEL_IMAGE_NAME=ghcr.io/529-studio/projectkv-model
MODEL_IMAGE_TAG=stg-latest
MODEL_CONTAINER_NAME=warded-model
MODEL_CPU_LIMIT=1.00
MODEL_MEMORY_LIMIT=512M
# CV_ENGINE_URL stays in the stack environment on purpose: it is a private
# service address (`http://warded-cv-engine:8000` on core-network), not a value
# the repository should pin.
CV_ENGINE_URL=<internal-cv-engine-endpoint>

# --- Upstream Portal & Caching ---
SNAPSHOT_UPSTREAM_BASE_URL=https://giaothong.hochiminhcity.gov.vn/render/ImageHandler.ashx
SNAPSHOT_CACHE_TTL_SECONDS=10
HOTSET_INTERVAL_SECONDS=30
HOTSET_ACTIVE_TTL_SECONDS=120

# --- Operational Alerting (Issue #441 / S14-T1 scope 4) ---
# [OPS_ALERT] thresholds for Hot Set feed dropouts and cv-engine failures.
OPS_ALERT_FEED_DROPOUT_THRESHOLD=5m
OPS_ALERT_CV_ENGINE_FAILURE_THRESHOLD=5m
OPS_ALERT_EVALUATE_INTERVAL=30s

# --- AI & Vision Analyzer ---
ANALYZER=vlm
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_API_KEY=
CLOUD_VISION_API_KEY=

# --- Developer Security & Gatekeeper (Issue #214 / Lesson 28) ---
DEV_ACCESS_TOKEN=

# --- Cloudflare Zero Trust Access & Cryptographic JWT Verification (Issue #421) ---
CF_ACCESS_AUDIENCE=<your-cf-access-audience>
CF_ACCESS_CERTS_URL=https://<your-team-name>.cloudflareaccess.com/cdn-cgi/access/certs
CF_ACCESS_TEAM_NAME=<your-team-name>
CF_ACCESS_CLIENT_ID=<your-cf-access-client-id>
CF_ACCESS_CLIENT_SECRET=<your-cf-access-client-secret>

# --- CORS Whitelist (Issue #421) ---
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,https://warded.529studio.site,https://warded-stg.529studio.site

# --- Blob Storage & Archiver (Issue #62, #214) ---
STORAGE_DRIVER=r2
STORAGE_LOCAL_ROOT=/app/data/proofs
R2_ACCOUNT_ID=<your-r2-account-id>
R2_BUCKET_NAME=warded-proofs
R2_REGION=auto
R2_ACCESS_KEY_ID=<your-r2-access-key-id>
R2_SECRET_ACCESS_KEY=<your-r2-secret-access-key>
ARCHIVE_SAMPLE_INTERVAL_SECONDS=900
ARCHIVE_RETENTION_DAYS=7

# --- Daily SQLite Backup & Restore (Issue #442 / S14-T2, Phase 3 rework) ---
# The warded-backup sidecar snapshots /app/data/camera-view.db once a day at
# 03:15 Asia/Ho_Chi_Minh, gzips it and uploads it to r2:homelab-backup/warded/
# with rclone. Credentials are R2_ACCESS_KEY_ID / R2_SECRET_ACCESS_KEY above;
# see docs/runbooks/sqlite_backup_restore.md for the restore procedure.
BACKUP_CONTAINER_NAME=warded-backup
BACKUP_CPU_LIMIT=0.10
BACKUP_MEMORY_LIMIT=128M
BACKUP_BUCKET_NAME=homelab-backup
BACKUP_KEEP_DAYS=14
BACKUP_VOLUME_NAME=warded-backup-staging
# One-shot root container that fixes volume ownership before first boot.
INIT_VOL_CONTAINER_NAME=warded-init-vol

# --- Telegram Alert Bot & Citizen Subscriptions (Issue #402 / S12-T4) ---
# Public handle only (not a credential). Empty disables the inbound webhook.
TELEGRAM_BOT_USERNAME=<your-telegram-bot-username>
# 32-256 chars from [A-Za-z0-9_-]; generate with `openssl rand -hex 32`.
# Never commit a real value.
TELEGRAM_WEBHOOK_SECRET=<your-telegram-webhook-secret>
TELEGRAM_BOT_TOKEN=<your-telegram-bot-token>
TELEGRAM_DEBOUNCE_MINUTES=30

