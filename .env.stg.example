# ==============================================================================
# Environment Configuration Template for Staging Deployment (Portainer Stack 14)
# ==============================================================================

# --- Infrastructure & Network ---
DOCKER_NETWORK=core-network
DATA_VOLUME_NAME=warded-stg_warded-stg-data
ROUTER_NAME=warded-stg
DOMAIN_NAME=warded-stg.529studio.site
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERTRESOLVER=cloudflare

# --- Backend Service (warded-backend) ---
BE_IMAGE_NAME=ghcr.io/529-studio/projectkv-backend
BE_IMAGE_TAG=stg-latest
BE_CONTAINER_NAME=warded-backend
BE_PORT=3000
BE_CPU_LIMIT=0.50
BE_MEMORY_LIMIT=256M
GIN_MODE=release
APP_ENV=staging
TZ=Asia/Ho_Chi_Minh
CAMERAS_FILE_PATH=/app/cameras_enriched.json
HEX_POLYGON_FILE_PATH=/app/h3_hex_polygons.json
SQLITE_PATH=/app/data/camera-view.db

# --- Frontend Service (warded-frontend) ---
FE_IMAGE_NAME=ghcr.io/529-studio/projectkv-frontend
FE_IMAGE_TAG=stg-latest
FE_CONTAINER_NAME=warded-frontend
FE_CPU_LIMIT=0.25
FE_MEMORY_LIMIT=64M

# --- Model Service (warded-model) ---
MODEL_IMAGE_NAME=ghcr.io/529-studio/projectkv-model
MODEL_IMAGE_TAG=stg-latest
MODEL_CONTAINER_NAME=warded-model
MODEL_CPU_LIMIT=1.00
MODEL_MEMORY_LIMIT=512M
CV_ENGINE_URL=http://warded-model:8000

# --- Upstream Portal & Caching ---
SNAPSHOT_UPSTREAM_BASE_URL=https://giaothong.hochiminhcity.gov.vn/render/ImageHandler.ashx
SNAPSHOT_CACHE_TTL_SECONDS=10
HOTSET_INTERVAL_SECONDS=30
HOTSET_ACTIVE_TTL_SECONDS=120

# --- AI & Vision Analyzer ---
ANALYZER=vlm
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_API_KEY=
CLOUD_VISION_API_KEY=

# --- Object Storage (Cloudflare R2) ---
STORAGE_DRIVER=r2
R2_ACCOUNT_ID=REDACTED_R2_ACCOUNT_ID
R2_ENDPOINT=https://REDACTED_R2_ACCOUNT_ID.r2.cloudflarestorage.com
R2_BUCKET_NAME=warded-proofs
R2_REGION=auto
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_URL=https://file.529studio.site
